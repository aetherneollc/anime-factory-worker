# Anime Factory GPU worker — dedicated LongLive 2.0 NVFP4 image.
# ComfyUI + Animagine stills (IP-Adapter) for missing keyframes; never H3 weights.
# Weights are NOT baked — first boot pulls HuggingFace onto instance-local disk (never R2).
#
# The NVFP4 stack matches the validated baseline in NVlabs/LongLive
# docs/getting_started.md ("NVFP4 Environment") and the
# Efficient-Large-Model/LongLive-2.0-5B-NVFP4-S2 model card:
#   Python 3.12 / PyTorch 2.10.0+cu128 / TorchVision 0.25.0+cu128 / CUDA 12.8 /
#   TorchAO 0.16.0 / FlashAttention 2.8.3 built from source.
# Dao-AILab publishes no cu12+torch2.10 release wheel for 2.8.3 (only cu13torch2.10),
# so flash-attn is compiled here for SM 12.0 and shipped as a wheel. FourOverSix and
# the LongLive KV-dequant extension are built the same way.
# Final stage is CUDA runtime-only (no nvcc). Do not pip install -e fouroversix there.

FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04 AS moss-sfx

ARG MOSS_TTS_REF=934d6826b084c46a0d033402174d5f8ac4ed2519
ARG MOSS_TORCH=2.9.0
ARG MOSS_TORCHAUDIO=2.9.0
ARG MOSS_TORCHVISION=0.24.0

COPY deploy/gpu-worker/install_moss_sfx_runtime.sh /tmp/install_moss_sfx_runtime.sh
RUN chmod +x /tmp/install_moss_sfx_runtime.sh \
    && MOSS_TTS_REF="${MOSS_TTS_REF}" MOSS_TORCH="${MOSS_TORCH}" \
       MOSS_TORCHAUDIO="${MOSS_TORCHAUDIO}" MOSS_TORCHVISION="${MOSS_TORCHVISION}" \
       /tmp/install_moss_sfx_runtime.sh \
    && rm -f /tmp/install_moss_sfx_runtime.sh

FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS nvfp4

ARG LONGLIVE_REF=6b36d20ec6f7958d29d11a704dfa64611a9f2572
# NVIDIA/cutlass revision pinned by mit-han-lab/fouroversix@FOUROVERSIX_REF.
# LongLive vendors fouroversix as plain files, so third_party/cutlass must be
# supplied explicitly; taking whatever is at a branch tip is not reproducible.
ARG FOUROVERSIX_REF=dadfad6901d473a734fe71e0b082e70ee993e23a
ARG CUTLASS_REF=ec8daf642d69fc31352ac6fa6e14a0de9019604b
ARG FLASH_ATTN_REF=060c9188beec3a8b62b33a3bfa6d5d2d44975fab
ARG FLASH_ATTN_VERSION=2.8.3
ARG LONGLIVE_TORCH=2.10.0
ARG LONGLIVE_TORCHVISION=0.25.0
ARG LONGLIVE_TORCHAUDIO=2.10.0
ARG LONGLIVE_TORCHAO=0.16.0

ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    CUDA_ARCHS=120 \
    FLASH_ATTN_CUDA_ARCHS=120 \
    TORCH_CUDA_ARCH_LIST=12.0 \
    MAX_JOBS=2 \
    NVCC_THREADS=2 \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         python3 python3-venv python3-dev git ninja-build g++ ca-certificates curl \
    && python3 -m venv /opt/venv \
    && rm -rf /var/lib/apt/lists/*

# cp312 ABI is what the whole stack is pinned against; anything else fails closed.
RUN python -c "import sys; v=sys.version_info; \
assert (v.major, v.minor) == (3, 12), f'need Python 3.12.x, got {sys.version}'; \
print('python', sys.version)"

RUN pip install --no-cache-dir --upgrade pip wheel \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 \
         "torch==${LONGLIVE_TORCH}+cu128" \
         "torchvision==${LONGLIVE_TORCHVISION}+cu128" \
         "torchaudio==${LONGLIVE_TORCHAUDIO}+cu128" \
    && pip install --no-cache-dir "torchao==${LONGLIVE_TORCHAO}" \
    && pip install --no-cache-dir ninja packaging psutil "setuptools>=77.0.3" \
    && LONGLIVE_TORCH="${LONGLIVE_TORCH}" LONGLIVE_TORCHVISION="${LONGLIVE_TORCHVISION}" python - <<'PY' \
    && rm -rf /root/.cache /tmp/* /var/tmp/*
import os
import torch
import torchvision

want_torch = os.environ["LONGLIVE_TORCH"] + "+cu128"
want_tv = os.environ["LONGLIVE_TORCHVISION"] + "+cu128"
if torch.__version__ != want_torch:
    raise SystemExit(f"torch {torch.__version__} != {want_torch}")
if torchvision.__version__ != want_tv:
    raise SystemExit(f"torchvision {torchvision.__version__} != {want_tv}")
if torch.version.cuda != "12.8":
    raise SystemExit(f"torch CUDA {torch.version.cuda} != 12.8")
print("torch", torch.__version__, "cuda", torch.version.cuda, "tv", torchvision.__version__)
PY

# Pin NVlabs/LongLive plus the CUTLASS revision its vendored fouroversix expects.
RUN git init /opt/LongLive \
    && git -C /opt/LongLive remote add origin https://github.com/NVlabs/LongLive.git \
    && git -C /opt/LongLive fetch --depth 1 origin "${LONGLIVE_REF}" \
    && git -C /opt/LongLive checkout --detach FETCH_HEAD \
    && mkdir -p /opt/LongLive/fouroversix/third_party/cutlass \
    && git init /opt/LongLive/fouroversix/third_party/cutlass \
    && git -C /opt/LongLive/fouroversix/third_party/cutlass remote add origin \
         https://github.com/NVIDIA/cutlass.git \
    && git -C /opt/LongLive/fouroversix/third_party/cutlass fetch --depth 1 origin "${CUTLASS_REF}" \
    && git -C /opt/LongLive/fouroversix/third_party/cutlass checkout --detach FETCH_HEAD \
    && rm -rf /opt/LongLive/fouroversix/third_party/cutlass/.git \
    && test -d /opt/LongLive/fouroversix/third_party/cutlass/include \
    && test -f /opt/LongLive/inference.py \
    && test -f /opt/LongLive/utils/inference_utils.py \
    && grep -q "def setup_nvfp4_pipeline" /opt/LongLive/utils/inference_utils.py \
    && grep -q "class ImagePromptDataset" /opt/LongLive/utils/dataset.py

WORKDIR /opt/LongLive/fouroversix
# FORCE_BUILD=1: never download a release wheel — always compile from the pinned source tree.
RUN mkdir -p /opt/longlive-wheels \
    && FORCE_BUILD=1 pip wheel --no-cache-dir --no-build-isolation --no-deps -w /opt/longlive-wheels . \
    && pip install --no-cache-dir --no-deps --no-build-isolation /opt/longlive-wheels/fouroversix*.whl \
    && python - <<'PY' \
    && rm -rf build /root/.cache /tmp/* /var/tmp/*
import importlib.metadata as im

version = im.version("fouroversix")
if version != "1.1.0":
    raise SystemExit(f"fouroversix {version} != 1.1.0")
dist = im.distribution("fouroversix")
so_files = [f for f in (dist.files or []) if str(f).endswith(".so")]
if not so_files:
    raise SystemExit("fouroversix wheel missing CUDA extension .so")
print("fouroversix", version, "so", len(so_files))
PY

# FlashAttention 2.8.3 from source, per docs/getting_started.md. Restricted to
# SM 12.0 so the 72 CUDA translation units stay inside the CI build budget.
RUN git init /tmp/flash-attention \
    && git -C /tmp/flash-attention remote add origin https://github.com/Dao-AILab/flash-attention.git \
    && git -C /tmp/flash-attention fetch --depth 1 origin "${FLASH_ATTN_REF}" \
    && git -C /tmp/flash-attention checkout --detach FETCH_HEAD \
    && FLASH_ATTENTION_FORCE_BUILD=TRUE FLASH_ATTN_CUDA_ARCHS=120 \
       pip wheel --no-cache-dir --no-build-isolation --no-deps \
         -w /opt/longlive-wheels /tmp/flash-attention \
    && pip install --no-cache-dir --no-deps --no-build-isolation /opt/longlive-wheels/flash_attn-*.whl \
    && FLASH_ATTN_VERSION="${FLASH_ATTN_VERSION}" python - <<'PY' \
    && rm -rf /tmp/flash-attention /root/.cache /tmp/* /var/tmp/*
import importlib.metadata as im
import os

want = os.environ["FLASH_ATTN_VERSION"]
version = im.version("flash_attn")
if not version.startswith(want):
    raise SystemExit(f"flash_attn {version} != {want}")
dist = im.distribution("flash_attn")
so_files = [f for f in (dist.files or []) if str(f).endswith(".so")]
if not so_files:
    raise SystemExit("flash_attn wheel missing CUDA extension .so")
print("flash_attn", version, "so", len(so_files))
PY

COPY deploy/gpu-worker/patches/kv_dequant_sm120a.patch /tmp/kv_dequant_sm120a.patch
WORKDIR /opt/LongLive/utils/kernel
# Upstream LongLive@6b36d20 hardcodes sm_100a; RTX 5090 + CUDA 12.8 needs sm_120a for kv_quant.
RUN grep -q 'compute_100a,code=sm_100a' setup.py \
    && patch -p1 --forward --batch < /tmp/kv_dequant_sm120a.patch \
    && grep -q 'compute_120a,code=sm_120a' setup.py \
    && ! grep -q 'compute_100a,code=sm_100a' setup.py \
    || (echo "kv_dequant_sm120a patch failed closed" >&2; exit 1) \
    && python setup.py build_ext --inplace \
    && python - <<'PY' \
    && rm -rf /root/.cache /tmp/* /var/tmp/*
from pathlib import Path

so_files = list(Path(".").glob("*.so"))
if not so_files:
    raise SystemExit("kv_dequant build_ext produced no .so")
text = Path("setup.py").read_text(encoding="utf-8")
if "compute_100a,code=sm_100a" in text or "compute_120a,code=sm_120a" not in text:
    raise SystemExit("kv_dequant gencode contract violated")
print("kv_dequant ok", so_files[0].name)
PY

# Runtime has CUDA libs (not nvcc). First boot imports fouroversix; it does not compile it.
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

ARG TARGETARCH=amd64
ARG COMFYUI_REF=7ba217d6b5ac7ef984b157f7e5dfc93465b9937d
ARG LONGLIVE_REF=6b36d20ec6f7958d29d11a704dfa64611a9f2572
ARG LONGLIVE_TORCH=2.10.0
ARG LONGLIVE_TORCHVISION=0.25.0
ARG LONGLIVE_TORCHAUDIO=2.10.0
ARG MOSS_TORCH=2.9.0
ARG MOSS_TORCHAUDIO=2.9.0
ARG MOSS_TORCHVISION=0.24.0

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    CUDA_ARCHS=120 \
    LONGLIVE_WHEELS=/opt/longlive-wheels \
    AF_IMAGE_CAPABILITY=longlive \
    AF_VIDEO_BACKEND=longlive \
    AF_GPU_PROFILE=longlive-nvfp4-sm120

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         python3 python3-venv ca-certificates curl ffmpeg git git-lfs libsndfile1 \
         fontconfig fonts-noto-cjk \
    && case "${TARGETARCH}" in amd64|x86_64) cf_arch=amd64 ;; arm64|aarch64) cf_arch=arm64 ;; *) cf_arch=amd64 ;; esac \
    && curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}" \
         -o /usr/local/bin/cloudflared \
    && chmod +x /usr/local/bin/cloudflared \
    && git lfs install \
    && git init /opt/ComfyUI \
    && git -C /opt/ComfyUI remote add origin https://github.com/comfyanonymous/ComfyUI.git \
    && git -C /opt/ComfyUI fetch --depth 1 origin "${COMFYUI_REF}" \
    && git -C /opt/ComfyUI checkout --detach FETCH_HEAD \
    && COMFYUI_REF="${COMFYUI_REF}" LONGLIVE_REF="${LONGLIVE_REF}" python3 - <<'PY' \
    && rm -rf /var/lib/apt/lists/*
import json
import os
import subprocess
from pathlib import Path

comfy = Path("/opt/ComfyUI")

def head(repo: Path) -> str:
    try:
        return subprocess.check_output(
            ["git", "-C", str(repo), "rev-parse", "HEAD"],
            text=True,
        ).strip()
    except Exception:
        return ""

manifest = {
    "comfyui_ref": os.environ["COMFYUI_REF"],
    "comfyui_sha": head(comfy),
    "longlive_ref": os.environ.get("LONGLIVE_REF", ""),
}
(comfy / ".af-source-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
PY

# Character consistency needs IPAdapterAdvanced, which core ComfyUI does not ship.
# Baked into the image so first boot does not clone on the leased card; the weights
# themselves still come from HuggingFace at boot (weights.STILL_FILES). Never H3.
ARG IPADAPTER_PLUS_REF=a0f451a5113cf9becb0847b92884cb10cbdec0ef
RUN git init /opt/ComfyUI/custom_nodes/ComfyUI_IPAdapter_plus \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI_IPAdapter_plus remote add origin \
         https://github.com/cubiq/ComfyUI_IPAdapter_plus.git \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI_IPAdapter_plus fetch --depth 1 origin "${IPADAPTER_PLUS_REF}" \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI_IPAdapter_plus checkout --detach FETCH_HEAD \
    && IPADAPTER_PLUS_REF="${IPADAPTER_PLUS_REF}" python3 - <<'PY' \
    && mkdir -p /opt/ComfyUI/models/ipadapter /opt/ComfyUI/models/clip_vision /opt/ComfyUI/models/visual_qc
import json
import os
import subprocess
from pathlib import Path

comfy = Path("/opt/ComfyUI")
ip = comfy / "custom_nodes" / "ComfyUI_IPAdapter_plus"
manifest_path = comfy / ".af-source-manifest.json"
manifest = {}
if manifest_path.is_file():
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
manifest["ipadapter_ref"] = os.environ["IPADAPTER_PLUS_REF"]
try:
    manifest["ipadapter_sha"] = subprocess.check_output(
        ["git", "-C", str(ip), "rev-parse", "HEAD"], text=True
    ).strip()
except Exception:
    manifest["ipadapter_sha"] = ""
manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
PY

COPY --from=nvfp4 /opt/venv /opt/venv
COPY --from=nvfp4 /opt/LongLive /opt/LongLive
COPY --from=nvfp4 /opt/longlive-wheels /opt/longlive-wheels
COPY --from=moss-sfx /opt/moss-sfx /opt/moss-sfx

WORKDIR /app

COPY python/ /app/python/
COPY schema/ /app/schema/
COPY workflows/ /app/workflows/
COPY config/ /app/config/
COPY deploy/gpu-worker/start.sh /usr/local/bin/af-start
COPY deploy/gpu-worker/moss_sfx_runner.py /opt/moss-sfx/moss_sfx_runner.py
RUN chmod +x /usr/local/bin/af-start \
    /opt/moss-sfx/moss_sfx_runner.py \
    && mkdir -p /work \
    && pip install --no-cache-dir --only-binary=:all: \
         "Pillow>=10,<12" huggingface_hub boto3 "open_clip_torch==2.32.0" \
         omegaconf einops easydict imageio imageio-ffmpeg av opencv-python-headless \
         ftfy sentencepiece peft "transformers>=4.49.0,<5" "accelerate>=1.1.1" \
         "diffusers==0.31.0" tqdm \
    && python3 - <<'PY'
from pathlib import Path
import subprocess
import sys

req = Path("/opt/ComfyUI/requirements.txt")
skip = {"torch", "torchvision", "torchaudio", "torchao", "open_clip_torch", "open-clip-torch"}
kept: list[str] = []
for line in req.read_text(encoding="utf-8").splitlines():
    pkg = line.strip().split("#", 1)[0].strip().split("[", 1)[0].split("==")[0].split(">=")[0].strip().lower()
    if pkg and pkg not in skip:
        kept.append(line)
filt = req.parent / ".af-comfy-requirements.filtered.txt"
filt.write_text("\n".join(kept) + ("\n" if kept else ""), encoding="utf-8")
if kept:
    subprocess.check_call(
        [
            sys.executable,
            "-m",
            "pip",
            "install",
            "--no-cache-dir",
            "--only-binary=:all:",
            "-r",
            str(filt),
            "--extra-index-url",
            "https://download.pytorch.org/whl/cu128",
        ]
    )
PY

# Nothing above may have pulled a different torch in as a transitive dependency,
# and the runtime stage must stay free of nvcc. GitHub-hosted runners lack
# libcuda.so.1 — verify wheel metadata and .so presence only; CUDA import/load
# is deferred to GPU preflight on the leased card.
RUN LONGLIVE_TORCH="${LONGLIVE_TORCH}" LONGLIVE_TORCHVISION="${LONGLIVE_TORCHVISION}" \
    LONGLIVE_TORCHAUDIO="${LONGLIVE_TORCHAUDIO:-2.10.0}" MOSS_TORCH="${MOSS_TORCH}" \
    MOSS_TORCHAUDIO="${MOSS_TORCHAUDIO}" MOSS_TORCHVISION="${MOSS_TORCHVISION}" python - <<'PY'
import importlib.metadata as im
import os
import shutil
import subprocess
import sys

import torch
import torchaudio
import torchvision

want_torch = os.environ["LONGLIVE_TORCH"] + "+cu128"
want_tv = os.environ["LONGLIVE_TORCHVISION"] + "+cu128"
want_ta = os.environ["LONGLIVE_TORCHAUDIO"] + "+cu128"
problems = []


def dist_has_so(dist_name: str) -> bool:
    dist = im.distribution(dist_name)
    return any(str(f).endswith(".so") for f in (dist.files or []))


if (sys.version_info.major, sys.version_info.minor) != (3, 12):
    problems.append(f"python {sys.version}")
if torch.__version__ != want_torch:
    problems.append(f"torch {torch.__version__} != {want_torch}")
if torchvision.__version__ != want_tv:
    problems.append(f"torchvision {torchvision.__version__} != {want_tv}")
if torchaudio.__version__ != want_ta:
    problems.append(f"torchaudio {torchaudio.__version__} != {want_ta}")
if torch.version.cuda != "12.8":
    problems.append(f"torch cuda {torch.version.cuda} != 12.8")
flash_version = im.version("flash_attn")
if not flash_version.startswith("2.8.3"):
    problems.append(f"flash_attn {flash_version} != 2.8.3")
elif not dist_has_so("flash_attn"):
    problems.append("flash_attn missing CUDA extension .so")
fouro_version = im.version("fouroversix")
if fouro_version != "1.1.0":
    problems.append(f"fouroversix {fouro_version} != 1.1.0")
elif not dist_has_so("fouroversix"):
    problems.append("fouroversix missing CUDA extension .so")
moss_probe = subprocess.check_output(
    [
        "/opt/moss-sfx/bin/python3.12",
        "-c",
        "import sys,torch,torchaudio,torchvision;"
        "print(sys.version_info.major,sys.version_info.minor,torch.__version__,"
        "torchaudio.__version__,torchvision.__version__,torch.version.cuda)",
    ],
    text=True,
).strip()
want_moss = (
    f"3 12 {os.environ['MOSS_TORCH']}+cu128 {os.environ['MOSS_TORCHAUDIO']}+cu128 "
    f"{os.environ['MOSS_TORCHVISION']}+cu128 12.8"
)
if moss_probe != want_moss:
    problems.append(f"moss runtime {moss_probe!r} != {want_moss!r}")
if shutil.which("nvcc"):
    problems.append("nvcc present in the runtime stage")
for command in ("gcc", "g++", "cc"):
    if shutil.which(command):
        problems.append(f"build tool present in runtime: {command}")
if problems:
    raise SystemExit("longlive_fail_closed: " + "; ".join(problems))
print(
    "runtime stack ok:",
    torch.__version__,
    torchvision.__version__,
    torchaudio.__version__,
    flash_version,
    fouro_version,
    moss_probe,
)
PY

ENV PYTHONPATH=/app/python \
    PYTHONUNBUFFERED=1 \
    VAST_DRY_RUN=1 \
    VAST_ALLOW_REPLACE=0 \
    ANIME_FACTORY_LIVE_VAST=0 \
    AF_START_COMFY=1 \
    AF_COMFY_REQS_BAKED=1 \
    AF_PRODUCTION_STACK=1 \
    ANIME_FACTORY_GPU_STILLS=1 \
    COMFYUI_DIR=/opt/ComfyUI \
    COMFYUI_BASE_URL=http://127.0.0.1:8199 \
    COMFY_BACKENDS=http://127.0.0.1:8188 \
    COMFY_ROUTER_HOST=127.0.0.1 \
    COMFY_ROUTER_PORT=8199 \
    LONGLIVE_ROOT=/opt/LongLive \
    LONGLIVE_WAN_DIR=/opt/LongLive/wan_models/Wan2.2-TI2V-5B \
    LONGLIVE_GENERATOR_CKPT=/opt/LongLive/checkpoints/longlive2_5b_nvfp4_s2/model_4o6.pt \
    LONGLIVE_WHEELS=/opt/longlive-wheels \
    LONGLIVE_REF=6b36d20ec6f7958d29d11a704dfa64611a9f2572 \
    LONGLIVE_NVFP4_SAMPLING_STEPS=2 \
    CUDA_ARCHS=120 \
    OPEN_CLIP_TORCH_VERSION=2.32.0 \
    AF_VISUAL_QC_CLIP_DIR=/opt/ComfyUI/models/visual_qc \
    AF_VISUAL_QC_CLIP_WEIGHTS=/opt/ComfyUI/models/visual_qc/open_clip_model.safetensors \
    AF_VISUAL_QC_CLIP_CONFIG=/opt/ComfyUI/models/visual_qc/open_clip_config.json \
    AF_OPEN_CLIP_MODEL=ViT-B-32 \
    AF_OPEN_CLIP_PRETRAINED=openai \
    MOSS_SFX_PYTHON=/opt/moss-sfx/bin/python3.12 \
    MOSS_SFX_SCRIPT=/opt/moss-sfx/moss_sfx_runner.py \
    MOSS_SFX_WEIGHTS_DIR=/work/.model-cache/moss-sfx \
    MOSS_SFX_DEVICE=cuda:0 \
    TORCHDYNAMO_DISABLE=1

LABEL org.aetherneo.anime-factory.comfy="true" \
      org.aetherneo.anime-factory.h3="false" \
      org.aetherneo.anime-factory.longlive="true" \
      org.aetherneo.anime-factory.video-backend="longlive" \
      org.aetherneo.anime-factory.kolors="true" \
      org.aetherneo.anime-factory.image-gen="true" \
      org.aetherneo.anime-factory.agent="true"

WORKDIR /app

ENTRYPOINT ["/usr/local/bin/af-start"]

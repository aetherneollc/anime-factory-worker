# Shared immutable source pins. Keep ARG defaults in Dockerfile and
# Dockerfile.longlive in sync with these values. Update only after canary.
# Official PyTorch runtime images already ship the torch trio — Dockerfiles
# must FROM these instead of pip installing torch.

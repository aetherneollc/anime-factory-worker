# Shared immutable source pins. Keep ARG defaults in Dockerfile and
# Dockerfile.longlive in sync with these values. Update only after canary.
COMFYUI_REF=7ba217d6b5ac7ef984b157f7e5dfc93465b9937d
IPADAPTER_PLUS_REF=a0f451a5113cf9becb0847b92884cb10cbdec0ef
# NVlabs/LongLive source pin for the dedicated NVFP4 image.
LONGLIVE_REF=6b36d20ec6f7958d29d11a704dfa64611a9f2572
# NVFP4 stack validated by NVlabs/LongLive docs/getting_started.md and the
# Efficient-Large-Model/LongLive-2.0-5B-NVFP4-S2 model card:
# Python 3.12, torch 2.10.0+cu128, torchvision 0.25.0+cu128, CUDA 12.8,
# torchao 0.16.0, FlashAttention 2.8.3 built from source.
LONGLIVE_TORCH=2.10.0+cu128
LONGLIVE_TORCHVISION=0.25.0+cu128
LONGLIVE_TORCHAUDIO=2.10.0+cu128
LONGLIVE_TORCHAO=0.16.0
# Dao-AILab/flash-attention v2.8.3. No cu12+torch2.10 release wheel exists
# (upstream ships cu13torch2.10 only), so this is compiled for SM 12.0.
FLASH_ATTN_VERSION=2.8.3
FLASH_ATTN_REF=060c9188beec3a8b62b33a3bfa6d5d2d44975fab
# mit-han-lab/fouroversix 1.1.0 and the NVIDIA/cutlass revision it pins.
# LongLive vendors fouroversix without third_party/, so cutlass is supplied here.
FOUROVERSIX_REF=dadfad6901d473a734fe71e0b082e70ee993e23a
CUTLASS_REF=ec8daf642d69fc31352ac6fa6e14a0de9019604b
H3_TORCH=2.8.0+cu128
H3_TORCHVISION=0.23.0+cu128
H3_TORCHAUDIO=2.8.0+cu128
# OpenMOSS/MOSS-TTS moss_soundeffect_v2 isolated inference-only environment.
# These are the exact [torch-cu128] pins in the subproject metadata at MOSS_TTS_REF.
MOSS_TTS_REF=934d6826b084c46a0d033402174d5f8ac4ed2519
MOSS_TORCH=2.9.0+cu128
MOSS_TORCHAUDIO=2.9.0+cu128
MOSS_TORCHVISION=0.24.0+cu128

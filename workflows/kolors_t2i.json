    "13": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["12", 0], "vae": ["2", 0] }
    },
    "14": {
      "class_type": "SaveImage",
      "inputs": { "images": ["13", 0], "filename_prefix": "kolors_still" }

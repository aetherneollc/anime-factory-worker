{
  "schema": "longlive2_short",
  "version": 1,
  "native_width": 1280,
  "native_height": 704,
  "fps": 24,
  "audio": false,
  "silent": true,
  "max_take_seconds": 60,
  "target_seconds": 120,
  "min_takes": 2,
  "max_takes": 3,
  "i2v": true,
  "first_take": "qc_keyframe",
  "same_scene_continue": "prior_last_frame",
  "scene_change": "new_keyframe_hard_cut",
  "continuation_mechanism": "i2v_first_frame",
  "compose": {
    "scale_pad_only": true,
    "delivery_width": 1280,
    "delivery_height": 720
  },
  "take_fields": [
    "take_id",
    "start_frame",
    "end_frame",
    "beats",
    "cuts",
    "cast",
    "first_frame",
    "prompt",
    "scene_id",
    "continue_from"
  ]
}
